{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "npm: typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "OpenClaw: inspect plugin",
      "type": "shell",
      "command": "openclaw plugins inspect deferred-compaction --runtime --json",
      "dependsOn": "npm: build",
      "problemMatcher": []
    }
  ]
}
