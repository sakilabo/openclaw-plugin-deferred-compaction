{
  "name": "openclaw-plugin-deferred-compaction",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw tools that compact Codex-backed sessions after the active turn ends.",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/cli-startup.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": "2026.10.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "openclaw": "^2026.10.3"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.3"
    },
    "build": {
      "openclawVersion": "2026.10.3"
    }
  },
  "license": "UPL-1.0"
}
